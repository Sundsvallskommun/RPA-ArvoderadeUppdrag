g&quot;) OrElse ul.Contains(&quot;dygn&quot;) Then&#xA;      unit = &quot;dag&quot;&#xA;    ElseIf ul.Contains(&quot;år&quot;) Then&#xA;      unit = &quot;år&quot;&#xA;    End If&#xA;    Dim kvantitet As String = qtyVal.ToString() &amp; &quot;/&quot; &amp; unit&#xA;&#xA;    ' Giltighetsperiod som sträng&#xA;    Dim gilPeriod As String = fromStr&#xA;    If decToHasValue Then gilPeriod = fromStr &amp; &quot; - &quot; &amp; toStr&#xA;&#xA;    ' OrderId (första) för att sedan hämta uppdragstagaren via Read Order&#xA;    Dim orderId As String = &quot;&quot;&#xA;    Dim oids As JToken = o(&quot;OrderIds&quot;)&#xA;    If oids IsNot Nothing AndAlso oids.Type = JTokenType.Array AndAlso oids.HasValues Then orderId = oids(0).ToString()&#xA;&#xA;    Dim personId As String = o.Value(Of String)(&quot;PersonId&quot;)&#xA;&#xA;    dt.Rows.Add(New Object() {&quot;&quot;, &quot;&quot;, kvantitet, gilPeriod, personId, orderId, &quot;&quot;})&#xA;  Next&#xA;End If&#xA;&#xA;out_Table = dt" DisplayName="Bygg LifeCare_Table (filtrera + kvantitet + period)" sap:VirtualizedContainerService.HintSize="524,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">

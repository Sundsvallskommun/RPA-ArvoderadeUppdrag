      </Assign.Value>
    </Assign>
    <Assign DisplayName="Lägg tabellen i dictionaryn" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[io_DictLifeCareTables(in_DictionaryKey)]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[LifeCare_Table]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
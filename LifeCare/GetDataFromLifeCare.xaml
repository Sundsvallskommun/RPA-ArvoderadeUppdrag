    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim dt As New System.Data.DataTable()&#xD;&#xA;dt.Columns.Add(&quot;Resurs&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Namn&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Kvantitet&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;Gil.period&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;ResursNamn&quot;, GetType(String))&#xD;&#xA;dt.Columns.Add(&quot;PersonId&quot;, GetType(String))&#xD;&#xA;&#xD;&#xA;Dim aRing As String = Char.ConvertFromUtf32(229)&#xD;&#xA;Dim unitManad As String = &quot;m&quot; &amp; aRing &amp; &quot;nad&quot;&#xD;&#xA;Dim unitAr As String = aRing &amp; &quot;r&quot;&#xD;&#xA;Dim inv As System.Globalization.CultureInfo = System.Globalization.CultureInfo.InvariantCulture&#xD;&#xA;Dim dateFrom As DateTime = DateTime.Parse(in_DateFrom)&#xD;&#xA;Dim dateTo As DateTime = DateTime.Parse(in_DateTo)&#xD;&#xA;&#xD;&#xA;Dim contactsArr As New JArray()&#xD;&#xA;If in_Contacts IsNot Nothing AndAlso in_Contacts.Type = JTokenType.Array Then contactsArr = DirectCast(in_Contacts, JArray)&#xD;&#xA;&#xD;&#xA;Dim nTotal As Integer = 0, nDeleted As Integer = 0, nWrongCat As Integer = 0, nWrongPeriod As Integer = 0&#xD;&#xA;Dim nNoQty As Integer = 0, nMedResurs As Integer = 0, nUtanResurs As Integer = 0&#xD;&#xA;&#xD;&#xA;If in_Items IsNot Nothing Then&#xD;&#xA;  For Each decTok As JToken In in_Items&#xD;&#xA;    Dim decObj As JObject = TryCast(decTok, JObject)&#xD;&#xA;    If decObj Is Nothing Then Continue For&#xD;&#xA;    nTotal += 1&#xD;&#xA;&#xD;&#xA;    If decObj.Value(Of Boolean?)(&quot;Deleted&quot;).GetValueOrDefault(False) Then nDeleted += 1 : Continue For&#xD;&#xA;&#xD;&#xA;    Dim catObj As JObject = TryCast(decObj(&quot;ServiceCategory&quot;), JObject)&#xD;&#xA;    Dim catCode As Integer = If(catObj IsNot Nothing AndAlso catObj(&quot;Code&quot;) IsNot Nothing, catObj.Value(Of Integer)(&quot;Code&quot;), -1)&#xD;&#xA;    If catCode &lt;&gt; in_TargetCategoryCode Then nWrongCat += 1 : Continue For&#xD;&#xA;&#xD;&#xA;    Dim decFrom As DateTime = decObj.Value(Of DateTime?)(&quot;FromDate&quot;).GetValueOrDefault(DateTime.MinValue)&#xD;&#xA;    Dim decTo As DateTime = decObj.Value(Of DateTime?)(&quot;ToDate&quot;).GetValueOrDefault(DateTime.MaxValue)&#xD;&#xA;    If decFrom &gt; dateTo OrElse decTo &lt; dateFrom Then nWrongPeriod += 1 : Continue For&#xD;&#xA;&#xD;&#xA;    ' Omfattning: första fält &gt; 0&#xD;&#xA;    Dim qtyVal As Double = 0&#xD;&#xA;    Dim unitText As String = &quot;&quot;&#xD;&#xA;    For Each qKey As String In New String() {&quot;Hour&quot;, &quot;Day&quot;, &quot;Quantity&quot;, &quot;Visit&quot;}&#xD;&#xA;      Dim jv As JValue = TryCast(decObj(qKey), JValue)&#xD;&#xA;      Dim num As Double = 0&#xD;&#xA;      If jv IsNot Nothing AndAlso jv.Value IsNot Nothing Then num = Convert.ToDouble(jv.Value, inv)&#xD;&#xA;      If num &gt; 0 Then&#xD;&#xA;        qtyVal = num&#xD;&#xA;        Dim typeObj As JObject = TryCast(decObj(qKey &amp; &quot;Type&quot;), JObject)&#xD;&#xA;        If typeObj IsNot Nothing Then unitText = If(typeObj.Value(Of String)(&quot;Text&quot;), &quot;&quot;)&#xD;&#xA;        Exit For&#xD;&#xA;      End If&#xD;&#xA;    Next&#xD;&#xA;    If qtyVal = 0 Then nNoQty += 1 : Continue For&#xD;&#xA;&#xD;&#xA;    ' LifeCare svarar på engelska (Month/Week/Day/Year)&#xD;&#xA;    Dim u As String = unitText.ToLower()&#xD;&#xA;    Dim unitName As String = unitManad&#xD;&#xA;    If u.Contains(&quot;week&quot;) OrElse u.Contains(&quot;vecka&quot;) Then&#xD;&#xA;      unitName = &quot;vecka&quot;&#xD;&#xA;    ElseIf u.Contains(&quot;day&quot;) OrElse u.Contains(&quot;dag&quot;) OrElse u.Contains(&quot;dygn&quot;) Then&#xD;&#xA;      unitName = &quot;dag&quot;&#xD;&#xA;    ElseIf u.Contains(&quot;year&quot;) OrElse u.Contains(unitAr) Then&#xD;&#xA;      unitName = unitAr&#xD;&#xA;    End If&#xD;&#xA;    Dim kvantitet As String = qtyVal.ToString(inv) &amp; &quot;/&quot; &amp; unitName&#xD;&#xA;&#xD;&#xA;    Dim gilPeriod As String = decFrom.ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot; - &quot; &amp; If(decTo.Year &gt;= 9999, &quot;tills vidare&quot;, decTo.ToString(&quot;yyyy-MM-dd&quot;))&#xD;&#xA;    Dim decId As String = decObj(&quot;Id&quot;).ToString()&#xD;&#xA;    Dim personId As String = If(decObj.Value(Of String)(&quot;PersonId&quot;), &quot;&quot;)&#xD;&#xA;&#xD;&#xA;    ' Koppla på decisionNo = lss_decisions.Id, och bara aktiva bokningar i perioden&#xD;&#xA;    Dim namn As String = &quot;&quot;&#xD;&#xA;    Dim resursList As New List(Of String)&#xD;&#xA;    Dim resursNamnList As New List(Of String)&#xD;&#xA;    For Each rmTok As JToken In contactsArr&#xD;&#xA;      Dim rmObj As JObject = TryCast(rmTok, JObject)&#xD;&#xA;      If rmObj Is Nothing OrElse rmObj(&quot;decisionNo&quot;) Is Nothing Then Continue For&#xD;&#xA;      If rmObj(&quot;decisionNo&quot;).ToString() &lt;&gt; decId Then Continue For&#xD;&#xA;&#xD;&#xA;      Dim clientObj As JObject = TryCast(rmObj(&quot;client&quot;), JObject)&#xD;&#xA;      If clientObj IsNot Nothing AndAlso namn = &quot;&quot; Then&#xD;&#xA;        namn = If(clientObj.Value(Of String)(&quot;lastName&quot;), &quot;&quot;) &amp; &quot;, &quot; &amp; If(clientObj.Value(Of String)(&quot;firstName&quot;), &quot;&quot;)&#xD;&#xA;      End If&#xD;&#xA;&#xD;&#xA;      Dim bookingsArr As JArray = TryCast(rmObj(&quot;bookings&quot;), JArray)&#xD;&#xA;      If bookingsArr Is Nothing Then Continue For&#xD;&#xA;      For Each bTok As JToken In bookingsArr&#xD;&#xA;        Dim b As JObject = TryCast(bTok, JObject)&#xD;&#xA;        If b Is Nothing Then Continue For&#xD;&#xA;        Dim status As Integer = b.Value(Of Integer?)(&quot;resourceStatus&quot;).GetValueOrDefault(0)&#xD;&#xA;        If status &lt;&gt; 2 AndAlso status &lt;&gt; 3 Then Continue For&#xD;&#xA;        Dim bStart As DateTime = b.Value(Of DateTime?)(&quot;startDate&quot;).GetValueOrDefault(DateTime.MaxValue)&#xD;&#xA;        Dim bEnd As DateTime = b.Value(Of DateTime?)(&quot;endDate&quot;).GetValueOrDefault(DateTime.MaxValue)&#xD;&#xA;        If bStart &gt; dateTo OrElse bEnd &lt; dateFrom Then Continue For&#xD;&#xA;        Dim cp As JObject = TryCast(b(&quot;contactPerson&quot;), JObject)&#xD;&#xA;        If cp Is Nothing Then Continue For&#xD;&#xA;        Dim resurs As String = If(cp.Value(Of String)(&quot;personId&quot;), &quot;&quot;)&#xD;&#xA;        If resurs = &quot;&quot; OrElse resursList.Contains(resurs) Then Continue For&#xD;&#xA;        resursList.Add(resurs)&#xD;&#xA;        resursNamnList.Add(If(cp.Value(Of String)(&quot;lastName&quot;), &quot;&quot;) &amp; &quot;, &quot; &amp; If(cp.Value(Of String)(&quot;firstName&quot;), &quot;&quot;))&#xD;&#xA;      Next&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;    If resursList.Count &gt; 0 Then nMedResurs += 1 Else nUtanResurs += 1&#xD;&#xA;    dt.Rows.Add(New Object() {String.Join(&quot;; &quot;, resursList), namn, kvantitet, gilPeriod, String.Join(&quot;; &quot;, resursNamnList), personId})&#xD;&#xA;  Next&#xD;&#xA;End If&#xD;&#xA;&#xD;&#xA;out_Log = &quot;Beslut in: &quot; &amp; nTotal &amp; &quot; | Deleted: &quot; &amp; nDeleted &amp; &quot; | fel insats: &quot; &amp; nWrongCat &amp; &quot; | utanfor period: &quot; &amp; nWrongPeriod &amp; &quot; | utan omfattning: &quot; &amp; nNoQty &amp; &quot; | med resurs: &quot; &amp; nMedResurs &amp; &quot; | utan resurs: &quot; &amp; nUtanResurs &amp; &quot; | behov fran Decision/Get: &quot; &amp; contactsArr.Count &amp; &quot; | rader ut: &quot; &amp; dt.Rows.Count&#xD;&#xA;out_Table = dt" DisplayName="Bygg LifeCare_Table (lss_decisions + Decision/Get" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">

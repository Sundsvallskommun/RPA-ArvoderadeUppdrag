    <ui:Comment DisplayName="Info" sap2010:WorkflowViewState.IdRef="Comment_1" Text="GetDataFromLifeCare (Arvoderade Uppdrag). Källor: lss_decisions (Kvantitet/period/insats/brukarens PersonId) + GetContactPersons (brukarens namn + uppdragstagare). GetContactPersons anropas EN gång av anroparen (Process) och skickas in som in_ContactPersonsJson. Matchning sker på brukarens personnummer (client.personId). Kontaktperson = ServiceCategory.Code 32 (övriga: Avlös 28, Korttid/stödfamilj 34, Ledsag 35)." />
    <Assign DisplayName="Assign TargetCategoryCode (per insats)" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[TargetCategoryCode]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32" xml:space="preserve">[If(in_ReportType.Contains("Kontaktperson"), 32,
If(in_ReportType.Contains("Avlös"), 28,
If(in_ReportType.Contains("Korttid") OrElse in_ReportType.Contains("stödfamilj"), 34,
If(in_ReportType.Contains("Ledsag"), 35,
-1))))]</InArgument>
      </Assign.Value>
    </Assign>
    <ld:Find_LSS_Decisions ClientCertPassword="{x:Null}" ClientCertPath="{x:Null}" ClientCertSecurePassword="{x:Null}" Limit="{x:Null}" MaxPages="{x:Null}" ModifiedAfter="{x:Null}" ModifiedBefore="{x:Null}" Offset="{x:Null}" PagesFetched="{x:Null}" PersonId="{x:Null}" ResponseCode="{x:Null}" TimeoutMs="{x:Null}" ValuesToMaskInLog="{x:Null}" ApiKey="[in_ApiKey]" BasePath="/WE.EC.Integration.Host" DisplayName="Find LSS Decisions" DomainId="[in_DomainId]" DomainUrl="[in_DomainUrl]" FetchAll="[True]" sap2010:WorkflowViewState.IdRef="Find_LSS_Decisions_1" Items="[LssDecisionsJson]" Query="[&quot;FromDate&lt;='&quot; &amp; in_DateTo &amp; &quot;'&quot;]" SendQueryInHeader="True" />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim dt As New System.Data.DataTable()&#xA;dt.Columns.Add(&quot;Resurs&quot;, GetType(String))&#xA;dt.Columns.Add(&quot;Namn&quot;, GetType(String))&#xA;dt.Columns.Add(&quot;Kvantitet&quot;, GetType(String))&#xA;dt.Columns.Add(&quot;Gil.period&quot;, GetType(String))&#xA;dt.Columns.Add(&quot;ResursNamn&quot;, GetType(String))&#xA;dt.Columns.Add(&quot;PersonId&quot;, GetType(String))&#xA;&#xA;Dim fromD As DateTime = DateTime.Parse(in_DateFrom)&#xA;Dim toD As DateTime = DateTime.Parse(in_DateTo)&#xA;&#xA;' Normalisera personnummer (bara siffror/bokstäver) för jämförelse&#xA;Dim norm = Function(p As String) If(String.IsNullOrEmpty(p), &quot;&quot;, System.Text.RegularExpressions.Regex.Replace(p, &quot;[^0-9A-Za-z]&quot;, &quot;&quot;))&#xA;&#xA;' Samla kontaktperson-svaret som en array (tål både array och enstaka objekt)&#xA;Dim contactsArr As JArray = New JArray()&#xA;If in_Contacts IsNot Nothing Then&#xA;  If in_Contacts.Type = JTokenType.Array Then&#xA;    contactsArr = CType(in_Contacts, JArray)&#xA;  ElseIf in_Contacts.Type = JTokenType.Object Then&#xA;    contactsArr.Add(in_Contacts)&#xA;  End If&#xA;End If&#xA;&#xA;If in_Items IsNot Nothing Then&#xA;  For Each tok As JToken In in_Items&#xA;    Dim o As JObject = TryCast(tok, JObject)&#xA;    If o Is Nothing Then Continue For&#xA;    If o.Value(Of Boolean?)(&quot;Deleted&quot;).GetValueOrDefault(False) Then Continue For&#xA;&#xA;    ' Insats (ServiceCategory.Code)&#xA;    Dim catCode As Integer = -1&#xA;    Dim catTok As JToken = o(&quot;ServiceCategory&quot;)&#xA;    If catTok IsNot Nothing AndAlso catTok.Type = JTokenType.Object Then&#xA;      Dim cc As Integer? = CType(catTok, JObject).Value(Of Integer?)(&quot;Code&quot;)&#xA;      If cc.HasValue Then catCode = cc.Value&#xA;    End If&#xA;    If catCode &lt;&gt; in_TargetCategoryCode Then Continue For&#xA;&#xA;    ' Periodöverlapp&#xA;    Dim fromStr As String = o.Value(Of String)(&quot;FromDate&quot;)&#xA;    Dim toStr As String = o.Value(Of String)(&quot;ToDate&quot;)&#xA;    Dim decFrom As DateTime = DateTime.MinValue&#xA;    If Not String.IsNullOrEmpty(fromStr) Then decFrom = DateTime.Parse(fromStr)&#xA;    Dim decToHasValue As Boolean = Not String.IsNullOrEmpty(toStr)&#xA;    Dim decTo As DateTime = DateTime.MaxValue&#xA;    If decToHasValue Then decTo = DateTime.Parse(toStr)&#xA;    If Not (decFrom &lt;= toD AndAlso ((Not decToHasValue) OrElse decTo &gt;= fromD)) Then Continue For&#xA;&#xA;    ' Kvantitet (ur lss_decisions): första fyllda av Hour/Day/Quantity/Visit + enhet&#xA;    Dim qtyVal As Double = 0&#xA;    Dim unitText As String = &quot;&quot;&#xA;    If o.Value(Of Double?)(&quot;Hour&quot;).GetValueOrDefault(0) &lt;&gt; 0 Then&#xA;      qtyVal = o.Value(Of Double)(&quot;Hour&quot;)&#xA;      If o(&quot;HourType&quot;) IsNot Nothing AndAlso o(&quot;HourType&quot;).Type = JTokenType.Object Then unitText = CType(o(&quot;HourType&quot;), JObject).Value(Of String)(&quot;Text&quot;)&#xA;    ElseIf o.Value(Of Double?)(&quot;Day&quot;).GetValueOrDefault(0) &lt;&gt; 0 Then&#xA;      qtyVal = o.Value(Of Double)(&quot;Day&quot;)&#xA;      If o(&quot;DayType&quot;) IsNot Nothing AndAlso o(&quot;DayType&quot;).Type = JTokenType.Object Then unitText = CType(o(&quot;DayType&quot;), JObject).Value(Of String)(&quot;Text&quot;)&#xA;    ElseIf o.Value(Of Double?)(&quot;Quantity&quot;).GetValueOrDefault(0) &lt;&gt; 0 Then&#xA;      qtyVal = o.Value(Of Double)(&quot;Quantity&quot;)&#xA;      If o(&quot;QuantityType&quot;) IsNot Nothing AndAlso o(&quot;QuantityType&quot;).Type = JTokenType.Object Then unitText = CType(o(&quot;QuantityType&quot;), JObject).Value(Of String)(&quot;Text&quot;)&#xA;    ElseIf o.Value(Of Double?)(&quot;Visit&quot;).GetValueOrDefault(0) &lt;&gt; 0 Then&#xA;      qtyVal = o.Value(Of Double)(&quot;Visit&quot;)&#xA;      If o(&quot;VisitType&quot;) IsNot Nothing AndAlso o(&quot;VisitType&quot;).Type = JTokenType.Object Then unitText = CType(o(&quot;VisitType&quot;), JObject).Value(Of String)(&quot;Text&quot;)&#xA;    End If&#xA;    If unitText Is Nothing Then unitText = &quot;&quot;&#xA;    Dim unit As String = &quot;månad&quot;&#xA;    Dim ul As String = unitText.ToLower()&#xA;    If ul.Contains(&quot;vecka&quot;) Then&#xA;      unit = &quot;vecka&quot;&#xA;    ElseIf ul.Contains(&quot;dag&quot;) OrElse ul.Contains(&quot;dygn&quot;) Then&#xA;      unit = &quot;dag&quot;&#xA;    ElseIf ul.Contains(&quot;år&quot;) Then&#xA;      unit = &quot;år&quot;&#xA;    End If&#xA;    Dim kvantitet As String = qtyVal.ToString() &amp; &quot;/&quot; &amp; unit&#xA;&#xA;    Dim gilPeriod As String = fromStr&#xA;    If decToHasValue Then gilPeriod = fromStr &amp; &quot; - &quot; &amp; toStr&#xA;&#xA;    Dim personId As String = o.Value(Of String)(&quot;PersonId&quot;)&#xA;    Dim pidN As String = norm(personId)&#xA;&#xA;    ' Matcha mot GetContactPersons på brukarens personnummer (client.personId)&#xA;    Dim matched As Boolean = False&#xA;    If pidN &lt;&gt; &quot;&quot; Then&#xA;      For Each cTok As JToken In contactsArr&#xA;        Dim cObj As JObject = TryCast(cTok, JObject)&#xA;        If cObj Is Nothing Then Continue For&#xA;        Dim clientTok As JToken = cObj(&quot;client&quot;)&#xA;        If clientTok Is Nothing OrElse clientTok.Type &lt;&gt; JTokenType.Object Then Continue For&#xA;        Dim clientObj As JObject = CType(clientTok, JObject)&#xA;        If norm(clientObj.Value(Of String)(&quot;personId&quot;)) &lt;&gt; pidN Then Continue For&#xA;        matched = True&#xA;        Dim clientNamn As String = If(clientObj.Value(Of String)(&quot;lastName&quot;), &quot;&quot;) &amp; &quot;, &quot; &amp; If(clientObj.Value(Of String)(&quot;firstName&quot;), &quot;&quot;)&#xA;        Dim bookings As JToken = cObj(&quot;bookings&quot;)&#xA;        If bookings IsNot Nothing AndAlso bookings.Type = JTokenType.Array Then&#xA;          For Each b As JToken In bookings&#xA;            Dim cp As JToken = b(&quot;contactPerson&quot;)&#xA;            If cp Is Nothing OrElse cp.Type &lt;&gt; JTokenType.Object Then Continue For&#xA;            Dim cpObj As JObject = CType(cp, JObject)&#xA;            Dim resurs As String = If(cpObj.Value(Of String)(&quot;personId&quot;), &quot;&quot;)&#xA;            Dim resursNamn As String = If(cpObj.Value(Of String)(&quot;lastName&quot;), &quot;&quot;) &amp; &quot;, &quot; &amp; If(cpObj.Value(Of String)(&quot;firstName&quot;), &quot;&quot;)&#xA;            dt.Rows.Add(New Object() {resurs, clientNamn, kvantitet, gilPeriod, resursNamn, personId})&#xA;          Next&#xA;        End If&#xA;      Next&#xA;    End If&#xA;&#xA;    ' Ingen kontaktperson hittad -&gt; lägg ändå en rad så beslutet syns (Resurs/Namn tom)&#xA;    If Not matched Then&#xA;      dt.Rows.Add(New Object() {&quot;&quot;, &quot;&quot;, kvantitet, gilPeriod, &quot;&quot;, personId})&#xA;    End If&#xA;  Next&#xA;End If&#xA;&#xA;out_Table = dt" DisplayName="Bygg LifeCare_Table (lss_decisions + GetContactPersons)" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="njl:JArray" x:Key="in_Items">[LssDecisionsJson]</InArgument>
        <InArgument x:TypeArguments="njl:JToken" x:Key="in_Contacts">[in_ContactPersonsJson]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_DateFrom">[in_DateFrom]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_DateTo">[in_DateTo]</InArgument>
        <InArgument x:TypeArguments="x:Int32" x:Key="in_TargetCategoryCode">[TargetCategoryCode]</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Table">[LifeCare_Table]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <Assign DisplayName="Init dictionary om tom" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, sd:DataTable)">[io_DictLifeCareTables]</OutArgument>
      </Assign.To>
      <Assign.Value>

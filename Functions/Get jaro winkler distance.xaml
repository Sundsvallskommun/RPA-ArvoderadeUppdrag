    <TryCatch DisplayName="Try Catch" sap:VirtualizedContainerService.HintSize="452,678" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <ui:InvokeCode ContinueOnError="{x:Null}" Code="' =====================================================================&#xD;&#xA;' JARO-WINKLER-LIKHET MELLAN TVÅ STRÄNGAR&#xD;&#xA;' ---------------------------------------------------------------------&#xD;&#xA;' In:  in_S1, in_S2 (String) - strängarna som jämförs (Nothing = &quot;&quot;)&#xD;&#xA;' Ut:  out_Score (Double)    - 0.0 = helt olika, 1.0 = identiska&#xD;&#xA;'&#xD;&#xA;' Koden ska ge samma resultat som Roboyo-aktiviteten&#xD;&#xA;' GetJaroWinklerDistance. Den avviker därför på två punkter från&#xD;&#xA;' &quot;läroboksversionen&quot;:&#xD;&#xA;'   1. Transpositioner räknas med heltalsdivision (halfTrans \ 2).&#xD;&#xA;'   2. Prefix-bonusen (Winkler) läggs bara på om Jaro &gt; 0.7.&#xD;&#xA;'&#xD;&#xA;' OBS: Jämförelsen skiljer på stora och små bokstäver (&quot;A&quot; &lt;&gt; &quot;a&quot;).&#xD;&#xA;' Gör ToLower/ToUpper på strängarna innan anropet om det inte är önskat.&#xD;&#xA;' =====================================================================&#xD;&#xA;&#xD;&#xA;' Gör om Nothing till tom sträng så att .Length inte kraschar.&#xD;&#xA;Dim s1 As String = If(in_S1, &quot;&quot;)&#xD;&#xA;Dim s2 As String = If(in_S2, &quot;&quot;)&#xD;&#xA;Dim len1 As Integer = s1.Length&#xD;&#xA;Dim len2 As Integer = s2.Length&#xD;&#xA;&#xD;&#xA;' ---------------------------------------------------------------------&#xD;&#xA;' SPECIALFALL: någon sträng är tom.&#xD;&#xA;' Båda tomma = identiska (1.0). Bara en tom = ingen likhet (0.0).&#xD;&#xA;' ---------------------------------------------------------------------&#xD;&#xA;If len1 = 0 OrElse len2 = 0 Then&#xD;&#xA;    out_Score = If(s1 = s2, 1.0, 0.0)&#xD;&#xA;Else&#xD;&#xA;    ' -----------------------------------------------------------------&#xD;&#xA;    ' STEG 1: HITTA MATCHANDE TECKEN&#xD;&#xA;    ' Två tecken räknas som matchning om de är lika OCH ligger högst&#xD;&#xA;    ' matchDistance positioner ifrån varandra.&#xD;&#xA;    ' matchDistance = (längsta strängens längd \ 2) - 1, minst 0.&#xD;&#xA;    ' Exempel: längder 8 och 12 -&gt; 12 \ 2 - 1 = 5.&#xD;&#xA;    ' -----------------------------------------------------------------&#xD;&#xA;    Dim matchDistance As Integer = Math.Max(0, Math.Max(len1, len2) \ 2 - 1)&#xD;&#xA;&#xD;&#xA;    ' Flaggor för vilka positioner i respektive sträng som har matchats.&#xD;&#xA;    ' Varje tecken i s2 får bara matchas en gång.&#xD;&#xA;    Dim s1Matches(len1 - 1) As Boolean&#xD;&#xA;    Dim s2Matches(len2 - 1) As Boolean&#xD;&#xA;    Dim matches As Integer = 0&#xD;&#xA;&#xD;&#xA;    ' Gå igenom varje tecken i s1 och leta efter samma tecken i s2&#xD;&#xA;    ' inom fönstret [i - matchDistance, i + matchDistance].&#xD;&#xA;    For i As Integer = 0 To len1 - 1&#xD;&#xA;        Dim lo As Integer = Math.Max(0, i - matchDistance)          ' Fönstrets start (inte under 0)&#xD;&#xA;        Dim hi As Integer = Math.Min(i + matchDistance + 1, len2)   ' Fönstrets slut (exklusivt, inte förbi s2)&#xD;&#xA;        For j As Integer = lo To hi - 1&#xD;&#xA;            ' Första lediga (ej redan matchade) lika tecknet tas.&#xD;&#xA;            If (Not s2Matches(j)) AndAlso s1(i) = s2(j) Then&#xD;&#xA;                s1Matches(i) = True&#xD;&#xA;                s2Matches(j) = True&#xD;&#xA;                matches += 1&#xD;&#xA;                Exit For   ' Gå vidare till nästa tecken i s1&#xD;&#xA;            End If&#xD;&#xA;        Next&#xD;&#xA;    Next&#xD;&#xA;&#xD;&#xA;    ' FELSÖK: logga matchDistance och matches här.&#xD;&#xA;&#xD;&#xA;    ' -----------------------------------------------------------------&#xD;&#xA;    ' Inga matchande tecken alls = ingen likhet.&#xD;&#xA;    ' (Behövs också för att undvika division med 0 nedan.)&#xD;&#xA;    ' -----------------------------------------------------------------&#xD;&#xA;    If matches = 0 Then&#xD;&#xA;        out_Score = 0.0&#xD;&#xA;    Else&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' STEG 2: RÄKNA TRANSPOSITIONER&#xD;&#xA;        ' Läs de matchade tecknen i ordning från båda strängarna och&#xD;&#xA;        ' jämför dem parvis. Varje par som skiljer sig är en&#xD;&#xA;        ' &quot;halv transposition&quot;.&#xD;&#xA;        ' Exempel: matchade tecken &quot;aco&quot; i s1 och &quot;cao&quot; i s2 -&gt;&#xD;&#xA;        '   a/c olika, c/a olika, o/o lika -&gt; halfTrans = 2.&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        Dim halfTrans As Integer = 0&#xD;&#xA;        Dim k As Integer = 0   ' Position i s2&#xD;&#xA;        For i As Integer = 0 To len1 - 1&#xD;&#xA;            If s1Matches(i) Then&#xD;&#xA;                ' Hoppa fram till nästa matchade tecken i s2.&#xD;&#xA;                While Not s2Matches(k)&#xD;&#xA;                    k += 1&#xD;&#xA;                End While&#xD;&#xA;                If s1(i) &lt;&gt; s2(k) Then halfTrans += 1&#xD;&#xA;                k += 1&#xD;&#xA;            End If&#xD;&#xA;        Next&#xD;&#xA;&#xD;&#xA;        ' Antal transpositioner = halva antalet, med HELTALSDIVISION&#xD;&#xA;        ' (3 \ 2 = 1, inte 1.5). Så räknar Roboyo; läroboken använder&#xD;&#xA;        ' 3 / 2 = 1.5. Skillnaden märks bara när halfTrans är udda.&#xD;&#xA;        Dim t As Integer = halfTrans \ 2&#xD;&#xA;&#xD;&#xA;        ' FELSÖK: logga halfTrans och t här.&#xD;&#xA;&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' STEG 3: JARO-VÄRDET&#xD;&#xA;        ' Medelvärdet av tre andelar:&#xD;&#xA;        '   m / len1      - andel av s1 som matchade&#xD;&#xA;        '   m / len2      - andel av s2 som matchade&#xD;&#xA;        '   (m - t) / m   - andel matchningar som står i rätt ordning&#xD;&#xA;        ' m görs till Double så att divisionerna inte blir heltal.&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        Dim m As Double = matches&#xD;&#xA;        Dim jaro As Double = (m / len1 + m / len2 + (m - t) / m) / 3.0&#xD;&#xA;&#xD;&#xA;        ' FELSÖK: logga jaro här. Jämför med Roboyo; skiljer det redan&#xD;&#xA;        ' här ligger felet i steg 1–3, inte i prefix-bonusen.&#xD;&#xA;&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        ' STEG 4: WINKLER-BONUS FÖR GEMENSAMT PREFIX&#xD;&#xA;        ' Läggs bara på om jaro &gt; 0.7 (Winklers tröskelvärde).&#xD;&#xA;        ' Prefix = antal lika tecken i början av båda strängarna,&#xD;&#xA;        ' max 4. Varje prefix-tecken flyttar resultatet 10 % närmare 1.0.&#xD;&#xA;        ' -------------------------------------------------------------&#xD;&#xA;        If jaro &gt; 0.7 Then&#xD;&#xA;            Dim prefix As Integer = 0&#xD;&#xA;            Dim maxPrefix As Integer = Math.Min(4, Math.Min(len1, len2))&#xD;&#xA;            For i As Integer = 0 To maxPrefix - 1&#xD;&#xA;                If s1(i) = s2(i) Then&#xD;&#xA;                    prefix += 1&#xD;&#xA;                Else&#xD;&#xA;                    Exit For   ' Prefixet slutar vid första olika tecken&#xD;&#xA;                End If&#xD;&#xA;            Next&#xD;&#xA;            out_Score = jaro + prefix * 0.1 * (1.0 - jaro)&#xD;&#xA;        Else&#xD;&#xA;            ' Under tröskeln: ingen bonus, ren Jaro.&#xD;&#xA;            out_Score = jaro&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;End If" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="450,165" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
          <ui:InvokeCode.Arguments>
            <InArgument x:TypeArguments="x:String" x:Key="in_S1">[in_String1]</InArgument>
            <InArgument x:TypeArguments="x:String" x:Key="in_S2">[in_String2]</InArgument>
            <OutArgument x:TypeArguments="x:Double" x:Key="out_Score">[out_Score]</OutArgument>
          </ui:InvokeCode.Arguments>
        </ui:InvokeCode>
      </TryCatch.Try>
